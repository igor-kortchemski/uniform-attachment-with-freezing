module

public import Freezing1.ForwardForestCutState
public import Freezing1.ForwardContinuationPrefix

/-!
# The complete cut forest is the genuine fresh forest continuation

The right-hand law is generated by the original uniform active-vertex
transition, started from the isolated lower-cut roots. This proves the full
forest-law bridge, rather than assuming it from the laws of a few statistics.
Old root names are still present here; erasing their names is a later step.
-/

@[expose] public section

namespace Freezing1.Forward

open Filter MeasureTheory
open scoped Classical ENNReal

set_option backward.isDefEq.respectTransparency false

theorem transitionLaw_forestCut {n : ℕ} {s : State} (hs : ValidAt n s)
    {a : ℕ} (ha : a ≤ n) (sign : Bool) :
    (transitionLaw s (n + 1) sign).map (fun t => forestCut t a) =
      transitionLaw (forestCut s a) (n + 1) sign := by
  by_cases hne : s.active.Nonempty
  · have hneC : (forestCut s a).active.Nonempty := hne
    rw [transitionLaw, ite_eq_left hne, transitionLaw, ite_eq_left hneC,
      Measure.map_map measurable_from_top measurable_from_top]
    apply Measure.map_congr
    have hmem : ∀ᵐ p ∂Measure.uniformOfFinset s.active, p ∈ s.active := by
      rw [ae_iff]
      simp [Measure.uniformOfFinset_apply]
    filter_upwards [hmem] with p hp
    exact forestCut_step hs ha hp sign
  · have hneC : ¬(forestCut s a).active.Nonempty := hne
    simp only [transitionLaw, hne, hneC, ite_false, Measure.map_dirac' measurable_from_top]

theorem continuationLaw_forestCut {x : SignSequence} {b k a : ℕ} {s : State}
    (hd : PhaseData x b s) (ha : a ≤ b)
    (hτ : ((b + k : ℕ) : ℕ∞) ≤ extinctionTime x) :
    (continuationLaw x b k s).map (fun t => forestCut t a) =
      continuationLaw x b k (forestCut s a) := by
  induction k generalizing b s with
  | zero => simp [continuationLaw]
  | succ k ih =>
    have hbτ : (b : ℕ∞) < extinctionTime x :=
      lt_of_lt_of_le (by exact_mod_cast (show b < b + (k + 1) by omega)) hτ
    have hpos := ((lt_extinctionTime_iff x b).mp hbτ) b le_rfl
    have hne : s.active.Nonempty := by
      apply Finset.card_pos.mp
      have hc := hd.count
      omega
    have hnext := transitionLaw_phaseData hd hne
    have hend : (((b + 1) + k : ℕ) : ℕ∞) ≤ extinctionTime x := by
      simpa only [Nat.add_assoc, Nat.add_comm 1 k] using hτ
    rw [continuationLaw, Measure.map_bind measurable_from_top.aemeasurable measurable_from_top.aemeasurable]
    calc
      _ = (transitionLaw s (b + 1) (x (b + 1))).bind
          (fun t => continuationLaw x (b + 1) k (forestCut t a)) := by
        apply Measure.bind_congr_right
        filter_upwards [hnext] with t ht
        exact ih ht (ha.trans (Nat.le_succ b)) hend
      _ = ((transitionLaw s (b + 1) (x (b + 1))).map (fun t => forestCut t a)).bind
          (continuationLaw x (b + 1) k) := by
        rw [Measure.bind_map measurable_from_top.aemeasurable measurable_from_top.aemeasurable]
      _ = _ := by rw [transitionLaw_forestCut hd.valid ha, continuationLaw]

/-- The actual complete conditional cut forest starts from isolated active
roots and uses exactly the original future transitions. -/
theorem continuationLaw_forestCut_at_cut {x : SignSequence} {a k : ℕ} {s : State}
    (hd : PhaseData x a s) (hτ : ((a + k : ℕ) : ℕ∞) ≤ extinctionTime x) :
    (continuationLaw x a k s).map (fun t => forestCut t a) =
      continuationLaw x a k (forestInitial s.active) := by
  rw [continuationLaw_forestCut hd le_rfl hτ, forestCut_at_cut hd.valid hd.labels]

/-- This joint law retains the entire earlier tree and complete later cut
forest. It does not infer their joint distribution from separate marginals. -/
theorem treeLaw_prefix_forestCut (x : SignSequence) {a b : ℕ}
    (hab : a ≤ b) (hb : (b : ℕ∞) ≤ extinctionTime x) :
    (treeLaw x b).map (fun t => (truncateAt t a, forestCut t a)) =
      (treeLaw x a).bind (fun s =>
        (continuationLaw x a (b - a) (forestInitial s.active)).map (fun F => (s, F))) := by
  have he : a + (b - a) = b := Nat.add_sub_of_le hab
  have haτ : (a : ℕ∞) ≤ extinctionTime x :=
    (by exact_mod_cast hab : (a : ℕ∞) ≤ b).trans hb
  have hτ : ((a + (b - a) : ℕ) : ℕ∞) ≤ extinctionTime x := by rw [he]; exact hb
  rw [← he, treeLaw_add_eq_bind_continuation,
    Measure.map_bind measurable_from_top.aemeasurable measurable_from_top.aemeasurable]
  apply Measure.bind_congr_right
  filter_upwards [treeLaw_hasHistory x a haτ] with s hs
  calc
    _ = (continuationLaw x a (b - a) s).map (fun t => (s, forestCut t a)) := by
      apply Measure.map_congr
      filter_upwards [continuationLaw_truncate_self hs hτ] with t ht
      rw [ht]
    _ = ((continuationLaw x a (b - a) s).map (fun t => forestCut t a)).map (fun F => (s, F)) := by
      rw [Measure.map_map measurable_from_top measurable_from_top]
      rfl
    _ = _ := by
      rw [continuationLaw_forestCut_at_cut hs.current hτ]
      simp only [Nat.add_sub_cancel_left]

end Freezing1.Forward

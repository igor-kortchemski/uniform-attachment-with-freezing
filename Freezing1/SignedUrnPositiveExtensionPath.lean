module

public import Freezing1.SignedUrnInfinite
public import Mathlib.Probability.Kernel.IonescuTulcea.Traj

/-! A canonical infinite signed urn with its genuine complete finite path laws. -/

@[expose] public section

namespace Freezing1.SignedUrn

open Filter MeasureTheory ProbabilityTheory
open scoped Classical ENNReal

set_option backward.isDefEq.respectTransparency false

instance : Countable Trajectory :=
  Function.Injective.countable (f := Trajectory.values) (fun a b h => by cases a; cases b; congr)

abbrev InfiniteUrnHistory := ℕ → ℤ

noncomputable def urnHistoryKernel (Z : ℕ → ℤ) (n : ℕ) :
    Kernel ((i : Finset.Iic n) → ℤ) ℤ where
  toFun H := transitionLaw (Z n) (Z (n + 1) - Z n) (H ⟨n, Finset.mem_Iic.mpr le_rfl⟩)
  measurable' := measurable_of_countable _

instance urnHistoryKernel_markov (Z : ℕ → ℤ) (n : ℕ) : IsMarkovKernel (urnHistoryKernel Z n) :=
  ⟨fun _ => by change IsProbabilityMeasure (transitionLaw _ _ _); infer_instance⟩

noncomputable def infiniteUrnLaw (Z : ℕ → ℤ) (u : ℤ) : Measure InfiniteUrnHistory :=
  Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) 0 (fun _ => u)

instance infiniteUrnLaw_probability (Z : ℕ → ℤ) (u : ℤ) : IsProbabilityMeasure (infiniteUrnLaw Z u) := by
  unfold infiniteUrnLaw
  infer_instance

def recordEval (a k : ℕ) : InfiniteUrnHistory → Trajectory := record (fun i H => H i) a k

theorem measurable_recordEval (a k : ℕ) : Measurable (recordEval a k) := by
  induction k generalizing a with
  | zero =>
    exact (measurable_of_countable (fun u : ℤ => (⟨[u]⟩ : Trajectory))).comp (measurable_pi_apply a)
  | succ k ih =>
    exact (measurable_of_countable (fun p : ℤ × Trajectory => prepend p.1 p.2)).comp
      ((measurable_pi_apply a).prodMk (ih (a + 1)))

theorem urn_traj_preserves_prefix (Z : ℕ → ℤ) (a : ℕ) (s : (i : Finset.Iic a) → ℤ) :
    ∀ᵐ H ∂Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) a s,
      Preorder.frestrictLe (π := fun _ : ℕ => ℤ) a H = s := by
  apply ae_of_ae_map (μ := Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) a s)
    (f := Preorder.frestrictLe (π := fun _ : ℕ => ℤ) a)
    (p := fun q : ((i : Finset.Iic a) → ℤ) => q = s) (by fun_prop)
  rw [Kernel.traj_map_frestrictLe_apply (X := fun _ => ℤ), Kernel.partialTraj_self, Kernel.id_apply]
  simp

theorem urn_partial_preserves_prefix (Z : ℕ → ℤ) (a : ℕ) (s : (i : Finset.Iic a) → ℤ) :
    ∀ᵐ H ∂Kernel.partialTraj (X := fun _ => ℤ) (urnHistoryKernel Z) a (a + 1) s,
      Preorder.frestrictLe₂ (π := fun _ : ℕ => ℤ) (Nat.le_succ a) H = s := by
  apply ae_of_ae_map (μ := Kernel.partialTraj (X := fun _ => ℤ) (urnHistoryKernel Z) a (a + 1) s)
    (f := Preorder.frestrictLe₂ (π := fun _ : ℕ => ℤ) (Nat.le_succ a))
    (p := fun q : ((i : Finset.Iic a) → ℤ) => q = s) (by fun_prop)
  rw [Kernel.partialTraj_map_frestrictLe₂_apply (X := fun _ => ℤ), Kernel.partialTraj_self, Kernel.id_apply]
  simp

theorem urn_partial_map_next (Z : ℕ → ℤ) (a : ℕ) (s : (i : Finset.Iic a) → ℤ) :
    (Kernel.partialTraj (X := fun _ => ℤ) (urnHistoryKernel Z) a (a + 1) s).map
      (fun H => H ⟨a + 1, Finset.mem_Iic.mpr le_rfl⟩) =
        transitionLaw (Z a) (Z (a + 1) - Z a) (s ⟨a, Finset.mem_Iic.mpr le_rfl⟩) := by
  have h := congrArg (fun κ : Kernel ((i : Finset.Iic a) → ℤ) ℤ => κ s)
    (Kernel.map_partialTraj_succ_self (X := fun _ => ℤ) (κ := urnHistoryKernel Z) a)
  rw [Kernel.map_apply _ (by fun_prop)] at h
  exact h

/-- Record the genuine trajectory generated by the signed-urn kernels.
Its complete joint law is the recursive finite path law, for every horizon. -/
theorem urn_traj_map_record (Z : ℕ → ℤ) (a k : ℕ) (s : (i : Finset.Iic a) → ℤ) :
    (Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) a s).map (recordEval a k) =
      pathLaw Z a k (s ⟨a, Finset.mem_Iic.mpr le_rfl⟩) := by
  induction k generalizing a with
  | zero =>
    calc
      _ = (Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) a s).map
          (fun _ => (⟨[s ⟨a, Finset.mem_Iic.mpr le_rfl⟩]⟩ : Trajectory)) := by
        apply Measure.map_congr
        filter_upwards [urn_traj_preserves_prefix Z a s] with H hH
        exact congrArg (fun u : ℤ => (⟨[u]⟩ : Trajectory))
          (congrFun hH ⟨a, Finset.mem_Iic.mpr le_rfl⟩)
      _ = _ := by simp [pathLaw]
  | succ k ih =>
    have hsplit : Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) a s =
        (Kernel.partialTraj (X := fun _ => ℤ) (urnHistoryKernel Z) a (a + 1) s).bind
          (Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) (a + 1)) := by
      rw [← Kernel.traj_comp_partialTraj (Nat.le_succ a), Kernel.comp_apply]
    rw [hsplit, Measure.map_bind (Kernel.measurable _).aemeasurable (measurable_recordEval a (k + 1)).aemeasurable]
    have htail (t : (i : Finset.Iic (a + 1)) → ℤ) :
        (Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) (a + 1) t).map (recordEval a (k + 1)) =
          (pathLaw Z (a + 1) k (t ⟨a + 1, Finset.mem_Iic.mpr le_rfl⟩)).map
            (prepend (t ⟨a, Finset.mem_Iic.mpr (Nat.le_succ a)⟩)) := by
      calc
        _ = (Kernel.traj (X := fun _ => ℤ) (urnHistoryKernel Z) (a + 1) t).map
            ((prepend (t ⟨a, Finset.mem_Iic.mpr (Nat.le_succ a)⟩)) ∘ recordEval (a + 1) k) := by
          apply Measure.map_congr
          filter_upwards [urn_traj_preserves_prefix Z (a + 1) t] with H hH
          change prepend (H a) (recordEval (a + 1) k H) = _
          rw [show H a = t ⟨a, Finset.mem_Iic.mpr (Nat.le_succ a)⟩ from
            congrFun hH ⟨a, Finset.mem_Iic.mpr (Nat.le_succ a)⟩]
          rfl
        _ = _ := by rw [← Measure.map_map (measurable_of_countable _) (measurable_recordEval _ _), ih]
    simp_rw [htail]
    calc
      _ = (Kernel.partialTraj (X := fun _ => ℤ) (urnHistoryKernel Z) a (a + 1) s).bind
          (fun t => (pathLaw Z (a + 1) k (t ⟨a + 1, Finset.mem_Iic.mpr le_rfl⟩)).map
            (prepend (s ⟨a, Finset.mem_Iic.mpr le_rfl⟩))) := by
        apply Measure.bind_congr_right
        filter_upwards [urn_partial_preserves_prefix Z a s] with t ht
        rw [show t ⟨a, Finset.mem_Iic.mpr (Nat.le_succ a)⟩ = s ⟨a, Finset.mem_Iic.mpr le_rfl⟩ from
          congrFun ht ⟨a, Finset.mem_Iic.mpr le_rfl⟩]
      _ = ((Kernel.partialTraj (X := fun _ => ℤ) (urnHistoryKernel Z) a (a + 1) s).map
          (fun t => t ⟨a + 1, Finset.mem_Iic.mpr le_rfl⟩)).bind
          (fun u => (pathLaw Z (a + 1) k u).map (prepend (s ⟨a, Finset.mem_Iic.mpr le_rfl⟩))) := by
        rw [Measure.bind_map (measurable_of_countable _).aemeasurable (measurable_of_countable _).aemeasurable]
      _ = _ := by rw [urn_partial_map_next]; rfl

theorem infiniteUrnLaw_hasPathLaws (Z : ℕ → ℤ) (u : ℤ) :
    HasPathLaws (fun i H => H i) Z u (infiniteUrnLaw Z u) := by
  intro k
  exact ⟨(measurable_recordEval 0 k).aemeasurable, urn_traj_map_record Z 0 k (fun _ => u)⟩

theorem recordEval_last (a k : ℕ) (H : InfiniteUrnHistory) (d : ℤ) :
    (recordEval a k H).values.getLastD d = H (a + k) := by
  induction k generalizing a d with
  | zero => rfl
  | succ k ih =>
    change (H a :: (recordEval (a + 1) k H).values).getLastD d = _
    rw [List.getLastD_cons, ih]
    congr 1
    omega

theorem pathLaw_map_last (Z : ℕ → ℤ) (a k : ℕ) (u d : ℤ) :
    (pathLaw Z a k u).map (fun H => H.values.getLastD d) = continuationLaw Z a k u := by
  induction k generalizing a u d with
  | zero => simp [pathLaw, continuationLaw]
  | succ k ih =>
    rw [pathLaw, Measure.map_bind (measurable_of_countable _).aemeasurable
      (measurable_of_countable _).aemeasurable, continuationLaw]
    congr 1
    funext v
    rw [Measure.map_map (measurable_of_countable _) (measurable_of_countable _)]
    simpa only [Function.comp_def, prepend, List.getLastD_cons] using ih (a + 1) v u

/-- Every finite original endpoint is an actual marginal of this infinite
Markov urn, in addition to its complete record-law identity. -/
theorem infiniteUrnLaw_map_eval (Z : ℕ → ℤ) (u : ℤ) (k : ℕ) :
    (infiniteUrnLaw Z u).map (fun H => H k) = continuationLaw Z 0 k u := by
  calc
    _ = (infiniteUrnLaw Z u).map ((fun T : Trajectory => T.values.getLastD 0) ∘ recordEval 0 k) := by
      apply Measure.map_congr
      exact ae_of_all _ (fun H => by
        simpa only [Nat.zero_add, Function.comp_def] using (recordEval_last 0 k H 0).symm)
    _ = ((infiniteUrnLaw Z u).map (recordEval 0 k)).map (fun T : Trajectory => T.values.getLastD 0) :=
      (Measure.map_map (measurable_of_countable _) (measurable_recordEval 0 k)).symm
    _ = _ := by
      rw [infiniteUrnLaw, urn_traj_map_record, pathLaw_map_last]

end Freezing1.SignedUrn
